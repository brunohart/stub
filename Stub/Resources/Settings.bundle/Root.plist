<plist version="1.0">
<dict>
	<key>StringsTable</key>
	<string>Root</string>
	<key>PreferenceSpecifiers</key>
	<array>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>The drawer</string>
			<key>FooterText</key>
			<string>Your stubs, your proofs and your signature go to your own private iCloud, so a new phone has them. Nobody else can read them, the maker of Stub included. Turn this off to keep everything on this phone. It takes effect the next time Stub opens.</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Keep in iCloud</string>
			<key>Key</key>
			<string>drawer.iCloud</string>
			<key>DefaultValue</key>
			<true/>
		</dict>
	</array>
